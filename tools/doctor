#!/usr/bin/env python3
"""seed doctor — immune surveillance for an instance.

Lints an Organizational Seed instance: links resolve, kinds' required
frontmatter present, fast-track ledger valid, leases fresh, applied
proposals carry rulings. Stdlib only. Exit 0 = clean, 1 = findings.

Usage: tools/doctor [path-to-instance-root]
"""
import os, re, sys, time

ROOT = os.path.realpath(sys.argv[1] if len(sys.argv) > 1 else ".")
findings = []
org_path = os.path.join(ROOT, "ORG.md")
org_text = open(org_path, encoding="utf-8").read() if os.path.isfile(org_path) else ""
SEED_SOURCE = bool(re.search(r"^#\s+\{Organization Name\}(?:\s|$)", org_text, re.M))

def finding(check, path, msg):
    findings.append(f"[{check}] {os.path.relpath(path, ROOT)}: {msg}")

def md_files():
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in
                       (".git", "node_modules", ".claude", "__pycache__")]
        for f in filenames:
            if f.endswith(".md"):
                yield os.path.join(dirpath, f)

def frontmatter(path):
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except Exception:
        return None
    if not lines or lines[0].strip() != "---":
        return None
    fm = {}
    for ln in lines[1:80]:
        if ln.strip() == "---":
            return fm
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", ln)
        if m:
            fm[m.group(1)] = m.group(2).strip()
    return None

def markdown_targets(path):
    """Return absolute local targets linked from a Markdown file."""
    targets = set()
    base = os.path.dirname(path)
    for target in LINK.findall(open(path, encoding="utf-8").read()):
        if target.startswith(("http://", "https://", "mailto:")) or "{" in target:
            continue
        target = target.split("#")[0]
        if target:
            targets.add(os.path.realpath(os.path.join(base, target)))
    return targets

def has_markdown_link(path, target_path, anchor=None):
    base = os.path.dirname(path)
    for target in LINK.findall(open(path, encoding="utf-8").read()):
        if target.startswith(("http://", "https://", "mailto:")) or "{" in target:
            continue
        file_part, separator, fragment = target.partition("#")
        if (file_part and os.path.realpath(os.path.join(base, file_part)) == target_path
                and (anchor is None or (separator and fragment.lower() == anchor.lower()))):
            return True
    return False

def rooted_path(value):
    """Resolve a repo-root-relative frontmatter path without escaping ROOT."""
    if not value:
        return None
    candidate = os.path.realpath(os.path.join(ROOT, value))
    try:
        if os.path.commonpath((ROOT, candidate)) != ROOT:
            return None
    except ValueError:
        return None
    return candidate

def inside(directory, path):
    return bool(path and os.path.commonpath((directory, path)) == directory)

def standing_knowledge_home(path):
    """Return whether a live file is an allowed Standing Knowledge home."""
    if not path or not os.path.isfile(path):
        return False
    exact_homes = {
        os.path.join(ROOT, name) for name in
        ("ORG.md", "KNOWLEDGE.md", "CONTEXT.md", "AUTHORITY.md", "AUTHORING.md")
    }
    exact_homes.update({
        os.path.join(ROOT, "processes", "_contract.md"),
        os.path.join(ROOT, "proposals", "0000-proposal-template.md"),
        os.path.join(ROOT, "decisions", "fast-track.md"),
        os.path.join(ROOT, "docs", "write-discipline.md"),
    })
    process_home = bool(
        inside(os.path.join(ROOT, "processes"), path)
        and os.path.basename(path) != "index.md"
        and (frontmatter(path) or {}).get("status") == "active"
    )
    role_home = inside(os.path.join(ROOT, "roles"), path)
    definition_home = os.path.basename(path) == "_kind.md"
    return path in exact_homes or process_home or role_home or definition_home

def historical_standing_knowledge_home(path):
    """Allow terminal Lessons to preserve a retired Process reference."""
    if standing_knowledge_home(path):
        return True
    return bool(
        path
        and os.path.isfile(path)
        and inside(os.path.join(ROOT, "processes"), path)
        and (frontmatter(path) or {}).get("status") == "retired"
    )

def retired_process_received_before_retirement(path, receipt_date):
    """A retired Process is an absorption receiver only for older receipts."""
    if not path or not os.path.isfile(path) or not valid_date(receipt_date):
        return False
    fm = frontmatter(path) or {}
    retired_on = fm.get("retired-on", "")
    return (
        inside(os.path.join(ROOT, "processes"), path)
        and fm.get("status") == "retired"
        and valid_date(retired_on)
        and receipt_date < retired_on
    )

def valid_date(value):
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value or ""):
        return False
    try:
        time.strptime(value, "%Y-%m-%d")
        return True
    except ValueError:
        return False

def meaningful_text(value):
    normalized = (value or "").strip().lower()
    placeholders = {"", "-", "...", "n/a", "na", "none", "pending", "tbd", "todo"}
    return normalized not in placeholders and "{" not in normalized

def ruling_field(text, label):
    match = re.search(
        rf"^\*\*{re.escape(label)}:\*\*\s*(.*?)\s*$", text, re.M | re.I
    )
    return match.group(1).strip() if match else ""

def row_targets(path, row):
    base = os.path.dirname(path)
    return {
        os.path.realpath(os.path.join(base, target.split("#")[0]))
        for target in LINK.findall(row)
        if not target.startswith(("http://", "https://", "mailto:"))
        and "{" not in target
        and target.split("#")[0]
    }

def row_has_link(path, row, target_path, anchor=None):
    base = os.path.dirname(path)
    for target in LINK.findall(row):
        file_part, separator, fragment = target.partition("#")
        if (file_part and os.path.realpath(os.path.join(base, file_part)) == target_path
                and (anchor is None or (separator and fragment.lower() == anchor.lower()))):
            return True
    return False

def approval_receipt_date(path, lesson, disposition, receiver=None):
    """Return the date of an exact Founder-governed Lesson outcome receipt."""
    if not path or not os.path.isfile(path):
        return False
    decisions_dir = os.path.join(ROOT, "decisions")
    proposals_dir = os.path.join(ROOT, "proposals")
    fm = frontmatter(path) or {}
    body = open(path, encoding="utf-8").read()
    links = markdown_targets(path)

    if path == os.path.join(decisions_dir, "fast-track.md"):
        for row in body.splitlines():
            if not row.startswith("|") or set(row.strip()) <= {"|", "-", " "}:
                continue
            cells = [cell.strip() for cell in row.strip().strip("|").split("|")]
            if len(cells) < 5 or cells[0].lower() == "date":
                continue
            exact_outcome = re.search(
                rf"^lesson outcome:\s*{re.escape(disposition)}\b", cells[2], re.I
            )
            targets = row_targets(path, row)
            exact_yes = cells[4].strip().lower() in ('"yes"', '“yes”')
            reason_link = disposition != "close" or row_has_link(
                path, row, lesson, "closure-reason"
            )
            if (valid_date(cells[0]) and exact_outcome
                    and cells[3].lower() == "approved" and exact_yes
                    and lesson in targets and reason_link
                    and (receiver is None or receiver in targets)):
                return cells[0]
        return None

    if inside(proposals_dir, path):
        ruling = re.search(r"^##\s+Ruling\s*$([\s\S]*)", body, re.M | re.I)
        ruling_text = ruling.group(1) if ruling else ""
        approved = fm.get("status") == "applied" and bool(
            ruling
            and ruling_field(ruling_text, "Outcome").lower() == "approved"
            and ruling_field(ruling_text, "Ruled by") == "Founder"
            and valid_date(ruling_field(ruling_text, "Date"))
            and ruling_field(ruling_text, "Lesson outcome").lower() == disposition
            and meaningful_text(ruling_field(ruling_text, "Reason"))
        )
        reason_link = disposition != "close" or has_markdown_link(
            path, lesson, "closure-reason"
        )
        if (approved and lesson in links and reason_link
                and (receiver is None or receiver in links)):
            return ruling_field(ruling_text, "Date")
        return None

    if inside(decisions_dir, path):
        # A standalone Decision may close a Lesson, but it cannot authorize the
        # conserved change required for absorption; that uses Proposal or fast-track.
        if disposition != "close":
            return None
        approved = (
            fm.get("kind") == "decision"
            and fm.get("status") == "ruled"
            and fm.get("ruled-by") == "Founder"
            and fm.get("outcome") == "approved"
            and fm.get("lesson-outcome") == disposition
            and valid_date(fm.get("date"))
        )
        if approved and has_markdown_link(path, lesson, "closure-reason"):
            return fm.get("date")
        return None

    return None

def approved_receipt(path, lesson, disposition, receiver=None):
    return bool(approval_receipt_date(path, lesson, disposition, receiver))

# D1 — relative links resolve. Exempt: blockquoted lines, and everything in
# proposals/ — the mutation queue quotes text for other destinations, whose
# links resolve at application time, not in place.
LINK = re.compile(r"\]\(([^)#\s][^)]*)\)")

# D0 — the Seed source ships runtime definitions, never its own runtime residue.
if SEED_SOURCE:
    allowed_seed_files = {
        os.path.join("proposals", "0000-proposal-template.md"),
        os.path.join("decisions", "fast-track.md"),
    }
    for folder in ("work", "lessons", "proposals", "decisions"):
        folder_path = os.path.join(ROOT, folder)
        if not os.path.isdir(folder_path):
            continue
        for dirpath, dirnames, filenames in os.walk(folder_path):
            for filename in filenames:
                if not filename.endswith(".md") or filename == "_kind.md":
                    continue
                path = os.path.join(dirpath, filename)
                relative = os.path.relpath(path, ROOT)
                if relative not in allowed_seed_files:
                    finding("seed-boundary", path,
                            "Seed source carries definitions, not live runtime residue; keep maintenance evidence in PRs, Git history, or ADRs")
    now_path = os.path.join(ROOT, "NOW.md")
    if os.path.isfile(now_path):
        now_fields = {}
        for line in open(now_path, encoding="utf-8"):
            match = re.match(r"^- \*\*(.+?):\*\*\s*(.+?)\s*$", line)
            if match:
                now_fields[match.group(1)] = match.group(2)
        for label in ("Current goal", "Active work", "Founder decision queue", "Next action"):
            value = now_fields.get(label, "")
            if not (value.startswith("{") and value.endswith("}")):
                finding("seed-boundary", now_path,
                        f"Seed source NOW.md must keep the '{label}' template placeholder, not live Working State")

for path in md_files():
    if os.sep + "proposals" + os.sep in path:
        continue
    base = os.path.dirname(path)
    for ln in open(path, encoding="utf-8").read().splitlines():
        if ln.lstrip().startswith(">"):
            continue
        for target in LINK.findall(ln):
            if target.startswith(("http://", "https://", "mailto:")) or "{" in target:
                continue
            t = target.split("#")[0]
            if t and not os.path.exists(os.path.normpath(os.path.join(base, t))):
                finding("links", path, f"dead relative link: {target}")

# D2 — kind-required frontmatter present on siblings
REQ = re.compile(r"`([a-z0-9_-]+)`")
for dirpath, dirnames, filenames in os.walk(ROOT):
    dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", ".claude")]
    if "_kind.md" not in filenames:
        continue
    kind = open(os.path.join(dirpath, "_kind.md"), encoding="utf-8").read()
    m = re.search(r"\*\*Required frontmatter[^*]*\*\*:?(.{0,600}?)(\n\n|\Z)", kind, re.S)
    required = [f for f in (REQ.findall(m.group(1)) if m else []) if f not in ("YYYY-MM-DD", "yyyy")]
    for f in filenames:
        if f == "_kind.md" or not f.endswith(".md"):
            continue
        p = os.path.join(dirpath, f)
        fm = frontmatter(p)
        if fm is None:
            finding("kinds", p, "no YAML frontmatter (kind requires one)")
            continue
        missing = [r for r in required if r not in fm]
        if missing:
            finding("kinds", p, f"missing required frontmatter: {', '.join(missing)}")

# D3 — fast-track ledger rows carry a verbatim ruling
ledger = os.path.join(ROOT, "decisions", "fast-track.md")
if os.path.exists(ledger):
    for i, ln in enumerate(open(ledger, encoding="utf-8"), 1):
        if not ln.startswith("|") or set(ln.strip()) <= {"|", "-", " "}:
            continue
        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
        if cells and cells[0].lower() in ("date",):
            continue
        if SEED_SOURCE:
            finding("seed-boundary", ledger,
                    f"row {i}: Seed source fast-track ledger must remain empty")
        if len(cells) >= 5:
            if not valid_date(cells[0]):
                finding("ledger", ledger, f"row {i}: invalid date — entry invalid")
            if cells[3].lower() not in ("approved", "rejected", "deferred"):
                finding("ledger", ledger, f"row {i}: invalid outcome — entry invalid")
            ruling_cell = cells[4]
        else:
            ruling_cell = cells[3] if len(cells) >= 4 else ""
        if not ruling_cell or '"' not in ruling_cell:
            finding("ledger", ledger, f"row {i}: no verbatim ruling — entry invalid")

# D4 — leases fresh (heartbeat within 30 min)
active = os.path.join(ROOT, "work", "_active")
if os.path.isdir(active):
    for f in os.listdir(active):
        if f.startswith("_") or not f.endswith(".md"):
            continue
        p = os.path.join(active, f)
        fm = frontmatter(p) or {}
        hb = fm.get("heartbeat", "")
        try:
            ts = time.mktime(time.strptime(hb[:19], "%Y-%m-%dT%H:%M:%S"))
            if time.time() - ts > 1800:
                finding("leases", p, f"stale lease (heartbeat {hb}) — breakable, or a crashed session to recover")
        except Exception:
            finding("leases", p, "lease without a parseable heartbeat")

# D5 — applied proposals carry a real Ruling
props = os.path.join(ROOT, "proposals")
if os.path.isdir(props):
    for f in os.listdir(props):
        if not f.endswith(".md") or f.startswith(("_", "0000")):
            continue
        p = os.path.join(props, f)
        fm = frontmatter(p) or {}
        if fm.get("status") == "applied":
            body = open(p, encoding="utf-8").read()
            m = re.search(r"##\s*Ruling(.+)\Z", body, re.S)
            if not m or "pending" in m.group(1)[:200].lower():
                finding("rulings", p, "status: applied but Ruling section missing or pending")

# D6 — mechanical conserved-file gate present and complete?
codeowner_paths = [os.path.join(ROOT, p) for p in
                   ("CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS")]
codeowner_paths = [path for path in codeowner_paths if os.path.isfile(path)]
if not codeowner_paths:
    finding("enforce", ROOT, "no CODEOWNERS — conserved files have no mechanical gate (see docs/enforcement.md)")
else:
    covered = set()
    for path in codeowner_paths:
        for line in open(path, encoding="utf-8"):
            match = re.match(r"^\s*(/\S+)", line)
            if match:
                covered.add(match.group(1))
    required_owners = {
        "/ORG.md", "/KNOWLEDGE.md", "/CONTEXT.md", "/AUTHORITY.md",
        "/AUTHORING.md", "/processes/", "/roles/", "/**/_kind.md",
        "/proposals/0000-proposal-template.md", "/decisions/fast-track.md",
        "/docs/write-discipline.md", "/.github/CODEOWNERS",
    }
    for missing in sorted(required_owners - covered):
        finding("enforce", codeowner_paths[0],
                f"conserved path '{missing}' is missing from CODEOWNERS")

# D7 — Process identity, shape, lifecycle, and discovery stay aligned. This
# catches mechanical drift only; AUTHORING.md still requires semantic review.
process_dir = os.path.join(ROOT, "processes")
draft_process_dir = os.path.join(ROOT, "work", "process-drafts")
process_index = os.path.join(process_dir, "index.md")
index_targets = markdown_targets(process_index) if os.path.isfile(process_index) else set()
active_processes = {}
historical_processes = {}
process_ids = {}
discoverable_processes = {}
PROCESS_STATUSES = {"active", "draft", "example", "retired"}
STOP_WORDS = {"a", "an", "and", "of", "process", "the", "to"}

def name_words(value):
    return {word for word in re.findall(r"[a-z0-9]+", value.lower())
            if len(word) > 2 and word not in STOP_WORDS}

def process_member_paths():
    for root in (process_dir, draft_process_dir):
        if not os.path.isdir(root):
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for filename in filenames:
                if not filename.endswith(".md"):
                    continue
                path = os.path.join(dirpath, filename)
                if path in (os.path.join(process_dir, "_contract.md"), process_index):
                    continue
                yield path

for path in process_member_paths():
    filename = os.path.basename(path)
    fm = frontmatter(path) or {}
    if fm.get("kind") != "process":
        finding("process-shape", path, "Process file must declare kind: process")
        continue
    process_id = fm.get("id", "")
    stem = os.path.splitext(filename)[0]
    if process_id != stem:
        finding("process-name", path,
                f"filename '{stem}' and id '{process_id or '(missing)'}' differ")
    status = fm.get("status", "")
    if status not in PROCESS_STATUSES:
        finding("process-lifecycle", path,
                "status must be active, draft, example, or retired")
    if status == "retired" and not valid_date(fm.get("retired-on", "")):
        finding("process-lifecycle", path,
                "retired Process must record retired-on as YYYY-MM-DD")
    in_drafts = inside(draft_process_dir, path)
    if status == "draft" and not in_drafts:
        finding("process-lifecycle", path,
                "draft Process must live under work/process-drafts/")
    if status != "draft" and in_drafts:
        finding("process-lifecycle", path,
                "only draft Processes may live under work/process-drafts/")
    if status == "active" and path not in index_targets:
        finding("process-lifecycle", path, "active Process is missing from processes/index.md")
    if status in ("draft", "retired") and path in index_targets:
        finding("process-lifecycle", path,
                f"{status} Process must not appear in processes/index.md")
    body = open(path, encoding="utf-8").read()
    title_match = re.search(r"^#\s+Process:\s*(.+?)\s*$", body, re.M | re.I)
    if not title_match:
        finding("process-name", path, "missing '# Process: …' title")
    elif process_id and not (name_words(process_id) & name_words(title_match.group(1))):
        finding("process-name", path,
                "id and title share no meaningful outcome word — review filename, id, title, and Outcome together")
    if status in ("active", "draft", "example"):
        headings = [
            heading.strip().lower()
            for heading in re.findall(r"^##\s+(.+?)\s*$", body, re.M)
        ]
        required_sections = [
            "outcome", "when to use", "boundaries", "evidence and approvals",
            "steps", "done when", "failure and recovery",
        ]
        if headings != required_sections:
            finding("process-shape", path,
                    "active/draft/example Process must have exactly the seven contract sections in order")
    if process_id:
        if process_id in process_ids:
            finding("process-name", path, f"duplicate Process id '{process_id}'")
        process_ids[process_id] = path
    if status == "active" and process_id:
        active_processes[process_id] = path
    if status in ("active", "example"):
        discoverable_processes[path] = {
            "title": title_match.group(1).strip() if title_match else "",
            "description": fm.get("description", ""),
        }
    if status in ("active", "retired") and process_id:
        historical_processes[process_id] = path

# The Process index is replaceable Machinery: every routing meaning must be an
# exact projection of Process frontmatter, never an independent rule.
index_row_counts = {}
if os.path.isfile(process_index):
    for line in open(process_index, encoding="utf-8"):
        match = re.match(
            r"^\|\s*\[([^]]+)\]\(([^)]+)\)\s*\|\s*(.*?)\s*\|\s*$", line
        )
        if not match:
            continue
        label, target_value, description = match.groups()
        target = os.path.realpath(os.path.join(process_dir, target_value.split("#")[0]))
        index_row_counts[target] = index_row_counts.get(target, 0) + 1
        expected = discoverable_processes.get(target)
        if not expected:
            finding("process-discovery", process_index,
                    f"index row points to a non-active, non-example Process: {target_value}")
            continue
        if label.strip().casefold() != expected["title"].casefold():
            finding("process-discovery", process_index,
                    f"index label for {target_value} must match its Process title")
        if not expected["description"] or description != expected["description"]:
            finding("process-discovery", process_index,
                    f"index description for {target_value} must exactly match Process frontmatter")
for path in discoverable_processes:
    if index_row_counts.get(path, 0) != 1:
        finding("process-discovery", process_index,
                f"active/example Process must have exactly one projected index row: {os.path.relpath(path, ROOT)}")

# D8 — Lessons remain queued until a real approved outcome exists.
lesson_dir = os.path.join(ROOT, "lessons")
pending_by_home = {}

def lesson_member_paths():
    for dirpath, dirnames, filenames in os.walk(lesson_dir):
        for filename in filenames:
            yield os.path.join(dirpath, filename)

if os.path.isdir(lesson_dir) and not SEED_SOURCE:
    for path in lesson_member_paths():
        dirpath, filename = os.path.split(path)
        if not filename.endswith(".md"):
            continue
        if path == os.path.join(lesson_dir, "_kind.md"):
            continue
        stem = os.path.splitext(filename)[0]
        if (dirpath != lesson_dir
                or not re.fullmatch(r"\d{4}-\d{2}-\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*", stem)):
            finding("lesson-identity", path,
                    "Lesson must be a top-level YYYY-MM-DD-what-it-teaches.md file")
        fm = frontmatter(path) or {}
        if fm.get("kind") != "lesson":
            finding("lesson-route", path, "kind must be 'lesson'")
            continue
        source_process = fm.get("source-process", "")
        if not source_process or source_process not in historical_processes:
            finding("lesson-route", path,
                    f"source-process '{source_process or '(missing)'}' does not name an active or retired Process")
        status = fm.get("status", "")
        if status not in ("pending", "absorbed", "retired"):
            finding("lesson-outcome", path,
                    "status must be pending, absorbed, or retired")
            continue
        applies_to_value = fm.get("applies-to", "")
        applies_to = None if applies_to_value == "unresolved" else rooted_path(applies_to_value)
        valid_applies_to = (
            standing_knowledge_home(applies_to)
            if status == "pending"
            else historical_standing_knowledge_home(applies_to)
        )
        if applies_to_value != "unresolved" and not valid_applies_to:
            finding("lesson-route", path,
                    "applies-to must name live Standing Knowledge, a terminal Lesson's retired Process receiver, or 'unresolved'")
        if status == "pending":
            home = applies_to_value or "(missing)"
            pending_by_home[home] = pending_by_home.get(home, 0) + 1
            continue

        decision_key = "decided-by" if status == "absorbed" else "closed-by"
        decision = rooted_path(fm.get(decision_key, ""))
        receipt_dirs = (os.path.join(ROOT, "decisions"), os.path.join(ROOT, "proposals"))
        if not decision or not os.path.isfile(decision) or not any(inside(d, decision) for d in receipt_dirs):
            finding("lesson-outcome", path,
                    f"{status} Lesson needs a live {decision_key} approval receipt")
            continue
        if decision not in markdown_targets(path):
            finding("lesson-outcome", path, f"Lesson body must link {decision_key}")

        if status == "absorbed":
            receiver = rooted_path(fm.get("absorbed-into", ""))
            receipt_date = approval_receipt_date(
                decision, os.path.realpath(path), "absorb", receiver
            )
            receiver_valid = bool(
                receiver
                and (
                    standing_knowledge_home(receiver)
                    or retired_process_received_before_retirement(receiver, receipt_date)
                )
                and receiver != decision
            )
            if not receiver_valid:
                finding("lesson-outcome", path,
                        "absorbed-into must be current Standing Knowledge or a retired Process that historically received it")
            elif applies_to != receiver:
                finding("lesson-outcome", path,
                        "absorbed-into must equal the reviewed applies-to home")
            else:
                lesson_links = markdown_targets(path)
                if receiver not in lesson_links or not receipt_date:
                    finding("lesson-outcome", path,
                            "Lesson and approved receipt must link the exact Lesson and receiving file")
        else:
            body = open(path, encoding="utf-8").read()
            reason = re.search(
                r"^##\s+Closure reason\s*$([\s\S]*?)(?=^##\s|\Z)",
                body, re.M | re.I,
            )
            if not reason or not meaningful_text(reason.group(1)):
                finding("lesson-outcome", path,
                        "retired Lesson needs a non-placeholder '## Closure reason'")
            if not approved_receipt(decision, os.path.realpath(path), "close"):
                finding("lesson-outcome", path,
                        "closure receipt must approve and link this exact Lesson")

pending_count = sum(pending_by_home.values())
queue_summary = f"lesson queue: {pending_count} pending across {len(pending_by_home)} proposed home(s)"

if findings:
    print(f"seed doctor: {len(findings)} finding(s)\n" + "\n".join("  " + f for f in findings))
    print(queue_summary)
    sys.exit(1)
print("seed doctor: clean")
print(queue_summary)
sys.exit(0)
