# D6a — an ACCESS.md policy activates explicit classification for every
# canonical Knowledge node. Missing metadata fails closed in enforcing Mounts,
# so the doctor reports it before a teammate discovers a mysteriously empty
# result. The vocabulary belongs to ACCESS.md; these are its mechanically
# valid field values.
if os.path.isfile(access_policy):
    policy_fields = access_policy_fields
    valid_access_scopes = set(access_scope_values)
    valid_write_classes = {
        value.strip() for value in policy_fields.get("write-classes", "").split(",")
        if value.strip()
    }
    frozen_write_classes = {"conserved", "ruled", "ledger"}
    if len(access_scope_values) > MAX_ACCESS_SCOPES:
        finding("access-policy", access_policy,
                f"access-scopes may declare at most {MAX_ACCESS_SCOPES} names")
    invalid_scope = next(
        (scope for scope in access_scope_values if not ACCESS_SCOPE_NAME.fullmatch(scope)), None
    )
    if invalid_scope is not None:
        finding("access-policy", access_policy,
                f"invalid access-scope '{invalid_scope}'; use a lowercase slug of at most 40 characters")
    if len(valid_access_scopes) != len(access_scope_values):
        finding("access-policy", access_policy, "access-scopes must be unique")
    if not {"core", "founder"}.issubset(valid_access_scopes):
        finding("access-policy", access_policy,
                "access-scopes must include core and founder")
    if valid_write_classes != frozen_write_classes:
        finding("access-policy", access_policy,
                "write-classes must be exactly conserved, ruled, ledger during the pilot")
    if not valid_access_scopes:
        finding("access-policy", access_policy,
