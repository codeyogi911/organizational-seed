goal_dir = os.path.join(ROOT, "goals")
goal_members = {}
goal_states = {}
GOAL_STATES = {"active", "achieved", "abandoned", "superseded"}

if os.path.isdir(goal_dir) and not SEED_SOURCE:
    for dirpath, dirnames, filenames in os.walk(goal_dir):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for filename in filenames:
            if not filename.endswith(".md") or filename == "_kind.md":
                continue
            path = os.path.join(dirpath, filename)
            if dirpath != goal_dir:
                finding("goal-identity", path,
                        "Goal must be one top-level Markdown file under goals/")
            fm = frontmatter(path) or {}
            if concept_type(fm) != "goal":
                finding("goal-shape", path, "Goal file must declare type: Goal")
                continue
            stem = os.path.splitext(filename)[0]
            goal_id = fm.get("id", "")
            if goal_id != stem:
                finding("goal-identity", path,
                        f"filename '{stem}' and id '{goal_id or '(missing)'}' differ")
            state = operational_state(fm)
            if state not in GOAL_STATES:
                finding("goal-lifecycle", path,
                        "state must be active, achieved, abandoned, or superseded")
            if not meaningful_text(fm.get("description", "")):
                finding("goal-shape", path, "Goal needs a non-placeholder description")
            if not meaningful_text(fm.get("set-by", "")):
                finding("goal-shape", path, "Goal needs the deciding Role in set-by")
            if not valid_date(fm.get("set-on", "")):
                finding("goal-shape", path, "Goal set-on must be YYYY-MM-DD")
            body = open(path, encoding="utf-8").read()
            direction = re.search(
                r"^##\s+Direction source\s*$([\s\S]*?)(?=^##\s|\Z)",
                body, re.M | re.I,
            )
            if not direction or not meaningful_text(direction.group(1)):
                finding("goal-shape", path,
                        "Goal needs a non-placeholder '## Direction source'")
            if goal_id:
                if goal_id in goal_members:
                    finding("goal-identity", path, f"duplicate Goal id '{goal_id}'")
