            fm = frontmatter(path) or {}
            scope = fm.get("access-scope", "")
            write_class = fm.get("write-class", "")
            machinery = filename in {"index.md", "_index.md"}
            missing = ["access-scope"] if not scope else []
            if not machinery and not write_class:
                missing.append("write-class")
            if missing:
